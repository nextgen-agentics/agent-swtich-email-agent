# Template for .env
# .env is gitignored; this template is committed.

# AgentSwitch logins — same email, one password per business
AS_EMAIL=
AS_SURYODAYA_PASSWORD=
AS_KEYSTONE_PASSWORD=

# LLM route (Revision 11). PROVIDER goes first, then the other provider; each call uses the first option
# that works, and a failing key or model is rested or dropped automatically. Logs name key SLOTS, never keys.
# gemini | openai (W&B Inference)
PROVIDER=gemini
# optional: replaces the first model of PROVIDER (older setting, still honoured)
# MODEL=
# false = only the first option (comparisons)
FALLBACK=true

# Gemini: key 1 serves everything; keys 2–5 are failover only (used while key 1 is rate-limited, out of
# today's quota or refused). They are never rotated to multiply quota — Google's terms forbid that.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

# W&B Inference (OpenAI-compatible): one key, models tried in this order
WANDB_API_KEY=
WANDB_PROJECT=
WANDB_MODELS=deepseek-ai/DeepSeek-V4.1-Flash,zai-org/GLM-5.3-Flash,Qwen/Qwen3-30B-A3B-Instruct-2507
OPENAI_BASE_URL=https://api.inference.wandb.ai/v1

# Limits
# per reply; a reply cut off by it is retried once with double
LLM_MAX_TOKENS=16000
# when every option is resting, wait at most this long, then the run stops cleanly
LLM_WAIT_MAX_S=120
# an option with server trouble rests this long
LLM_BREAKER_S=60
# one model call; a call that runs longer counts as server trouble (rest, then the next option)
LLM_TIMEOUT_S=180
